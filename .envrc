#!/usr/bin/env bash
# direnv hook: SOPS + Age で暗号化された secrets.env を復号して環境変数に展開する。
# - 平文の .env はリポジトリにコミットしない (.gitignore 済)
# - secrets.env は git にコミットされ、Age 鍵を持つ人だけが復号できる
# - Age 鍵は以下のいずれかで指定する:
#   1. SOPS_AGE_KEY_FILE で示すファイル (デフォルト: ~/.config/sops/age/keys.txt)
#   2. SOPS_AGE_KEY 環境変数に鍵本体を直接設定

if [[ -z "${SOPS_AGE_KEY_FILE:-}" ]]; then
  export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
fi

if [[ ! -r "$SOPS_AGE_KEY_FILE" && -z "${SOPS_AGE_KEY:-}" ]]; then
  log_error "Age 鍵が見つかりません: $SOPS_AGE_KEY_FILE が読めず、SOPS_AGE_KEY も未設定"
  log_error "セットアップ手順は docs/setup.md の「シークレット管理 (SOPS + Age)」を参照"
  return 1
fi

if has sops && [[ -f secrets.env ]]; then
  watch_file secrets.env
  decrypted=$(sops --decrypt secrets.env) || {
    log_error "secrets.env の復号に失敗 (Age 鍵 / .sops.yaml の recipient を確認)"
    return 1
  }
  set -a
  eval "$decrypted"
  set +a
  unset decrypted
elif [[ -f .env ]]; then
  # SOPS 移行前のローカル fallback (.env が残っている場合のみ)
  dotenv .env
fi

# .envrc 末尾に追加 (任意)
missing=$(comm -23 <(grep -E '^[A-Z_]+=' .env.example | cut -d= -f1 | sort -u) \
                    <(sops -d secrets.env | grep -E '^[A-Z_]+=' | cut -d= -f1 | sort -u))
if [[ -n "$missing" ]]; then
  log_status ".env.example にあって secrets.env に無いキー: $missing"
fi
